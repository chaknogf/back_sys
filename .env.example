# ========================================
# .env — CONFIGURACIÓN DEL PROYECTO
# Copia este archivo como .env y complétalo
# cp .env.example .env
# ========================================

# ────────────────────────────────
# BASE DE DATOS POSTGRESQL
# ────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_DB=hospital
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ────────────────────────────────
# JWT — CLAVE SECRETA (¡LA MÁS IMPORTANTE!)
# ────────────────────────────────
# Genera la tuya ejecutando:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera_tu_clave_aqui

# Tiempo de vida del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ────────────────────────────────
# CONFIGURACIÓN DE CORREO
# ────────────────────────────────
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME="Hospital Tecpán - Sistema"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# ────────────────────────────────
# RENAP API (Ministerio de Salud)
# ────────────────────────────────
# Solicitar API key en: https://salud-digital.mspas.gob.gt
RENAP_API_KEY=tu_api_key_renap_aqui

# ────────────────────────────────
# ENTORNO
# ────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ────────────────────────────────
# URL FRONTEND (para CORS y correos)
# ────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ────────────────────────────────
# REDIS (caché de respuestas frecuentes)
# ────────────────────────────────
# Descomentar y configurar si se quiere caché distribuida
# REDIS_URL=redis://localhost:6379/0

# ────────────────────────────────
# CORS (orígenes permitidos, separados por coma)
# ────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ────────────────────────────────
# SEGURIDAD (Hosts permitidos, separados por coma)
# ────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,hgtecpan.duckdns.org,*

# ────────────────────────────────
# CONCURRENCIA Y ESCALABILIDAD
# ────────────────────────────────
# Número de workers (CPU cores * 2 + 1 es buena regla)
WORKERS=4
# Pool de conexiones PostgreSQL por worker
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ────────────────────────────────
# CIE-10 CHATBOX (Ollama local por defecto)
# ────────────────────────────────
# Proveedor: ollama, openai (GPT/NVIDIA/compatible), gemini
# Instalar ollama: brew install ollama && ollama pull phi3:mini
CIE10_LLM_PROVIDER=ollama
CIE10_LLM_MODEL=phi3:mini
# CIE10_LLM_API_KEY=tu_api_key_aqui
# CIE10_LLM_BASE_URL=https://api.openai.com/v1  # OpenAI-compatible base URL
# Host de Ollama (default localhost)
# OLLAMA_HOST=http://localhost:11434
