# ========================================
# .env — CONFIGURACIÓN DEL PROYECTO
# Copia este archivo como .env y complétalo
# cp .env.example .env
# ========================================

# ────────────────────────────────
# BASE DE DATOS POSTGRESQL
# ────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_DB=hospital
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ────────────────────────────────
# JWT — CLAVE SECRETA (¡LA MÁS IMPORTANTE!)
# ────────────────────────────────
# Genera la tuya ejecutando:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera_tu_clave_aqui

# Tiempo de vida del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ────────────────────────────────
# CONFIGURACIÓN DE CORREO
# ────────────────────────────────
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME="Hospital Tecpán - Sistema"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# ────────────────────────────────
# ENTORNO
# ────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ────────────────────────────────
# URL FRONTEND (para CORS y correos)
# ────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ────────────────────────────────
# CORS (orígenes permitidos, separados por coma)
# ────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
