[Unit]
Description=BackSys Hospital API
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
Type=simple
User=matrix
Group=matrix
WorkingDirectory=/opt/back_sys
EnvironmentFile=/opt/back_sys/.env
Environment="PATH=/opt/back_sys/env/bin"
ExecStart=/opt/back_sys/env/bin/python -m gunicorn main:app -k uvicorn.workers.UvicornWorker -w 4 -b 127.0.0.1:8015
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
